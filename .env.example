# Educational local defaults are also supplied by Compose for one-command startup.
# For a shared environment set independent random values before first startup.
# Use URL-unreserved characters (for example, hex) because Compose builds DSNs.
# Changing these values does not rotate passwords in an existing PostgreSQL volume.
POSTGRES_PASSWORD=ledger-local-bootstrap-only
MIGRATOR_PASSWORD=ledger-local-migrator-only
APP_PASSWORD=ledger-local-app-only
FIXTURE_PASSWORD=ledger-local-fixture-only
PUBLISHER_PASSWORD=ledger-local-publisher-only
API_TOKEN=ledger-local-demo-token-change-me
HTTP_PORT=8080
METRICS_PORT=9090
DB_MAX_CONNS=16
RECONCILE_INTERVAL=60s
